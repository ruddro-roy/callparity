# CallParity environment
# Copy to .env. Inside containers use compose DNS (api, postgres, redis, fixtures), never localhost.

# true = FixtureCalle (FR-1842 / FR-1900 / FR-1888). false = LiveCalleSdk (plan/run/get).
USE_FIXTURES=true

# In-cluster URL the proxy uses to reach FastAPI.
API_URL=http://api:8000
# Browser-side URL. Leave empty so the UI uses same-origin /v1 via the proxy.
NEXT_PUBLIC_API_URL=
VITE_PUBLIC_API_URL=

DATABASE_URL=postgresql+psycopg2://callparity:callparity@postgres:5432/callparity
POSTGRES_HOST=postgres
# Local without docker: sqlite+pysqlite:///./callparity.db
REDIS_URL=redis://redis:6379/0
REDIS_OPTIONAL=false

CALLE_BASE_URL=http://fixtures:8080
# Required when USE_FIXTURES=false. Bearer token for POST/GET /v1/calls.
CALLE_API_TOKEN=
# If set, POST /v1/webhooks/calle requires X-Calle-Signature HMAC-SHA256 (fail closed).
CALLE_WEBHOOK_SECRET=

LOG_LEVEL=INFO
SEED_ON_STARTUP=true
PLAYBACK_DELAY_MS=180
