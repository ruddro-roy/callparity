# CallParity environment
# Copy to .env. Inside containers use compose DNS (api, postgres, redis), never localhost.

# true = FixtureCalle (FR-1842 / FR-1900 / FR-1888). false = LiveCalleSdk (POST /v1/calls).
USE_FIXTURES=true

DATABASE_URL=postgresql+psycopg2://callparity:callparity@postgres:5432/callparity
# Local without docker: sqlite+pysqlite:///./callparity.db
REDIS_URL=redis://redis:6379/0
REDIS_OPTIONAL=false

# Base URL of the CALL-E API (https://api.heycall-e.com). Ignored while USE_FIXTURES=true.
CALLE_BASE_URL=
# Required when USE_FIXTURES=false. Bearer token for POST/GET /v1/calls.
CALLE_API_TOKEN=
# If set, POST /v1/webhooks/calle requires X-Calle-Signature HMAC-SHA256 (fail closed).
CALLE_WEBHOOK_SECRET=

# Operator token. preview, parity, and import require Authorization: Bearer <this>.
# healthz and readyz stay public. This demo value is shared by the API and the
# workbench build (VITE_OPERATOR_TOKEN) so compose and CI work out of the box.
# Replace it for any real deployment.
OPERATOR_TOKEN=callparity-demo-operator

# Budget for the mutating routes (preview, parity, import, create-ticket,
# cancel-job), per operator fingerprint, falling back to client IP. Over
# budget is 429 with Retry-After. Must be >= 1; there is no off switch.
RATE_LIMIT_PER_MINUTE=60

# scripts/live_hours_call.py also reads CALLE_LIVE_TO_PHONE (E.164) and
# CALLE_CONSENT=yes. Export those in the shell; keep phone numbers out of files.

LOG_LEVEL=INFO
SEED_ON_STARTUP=true
PLAYBACK_DELAY_MS=180
